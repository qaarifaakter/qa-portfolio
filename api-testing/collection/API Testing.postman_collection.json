							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Created user data is correct\", function () {",
							"    const response = pm.response.json();",
							"",
							"    pm.expect(response.name).to.eql(\"Arifa\");",
							"    pm.expect(response.job).to.eql(\"QA Engineer\");",
							"});",
							"",
							"pm.test(\"Response contains generated ID\", function () {",
							"    const response = pm.response.json();",
							"",
							"    pm.expect(response.id).to.exist;",
							"    pm.expect(response.createdAt).to.exist;",
							"});"
						],
